pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                sh '''
                    echo "Checking Python installation..."
                    which python3
                    python3 --version
                    python3 -m pip --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    python3 -m pytest
                '''
            }
        }
    }

    post {
        success {
            echo '5G RAN CI Pipeline PASSED'
        }

        failure {
            echo '5G RAN CI Pipeline FAILED'
        }
    }
}